{
  "type": "object",
  "required": ["verdicts"],
  "additionalProperties": true,
  "properties": {
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict", "evidence", "why"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "verdict": { "type": "string", "enum": ["match", "loose", "mismatch"] },
          "evidence": { "type": "string", "minLength": 8, "maxLength": 400 },
          "why": { "type": "string", "minLength": 10, "maxLength": 400 },
          "suggested_id": { "type": "string", "maxLength": 64 },
          "flag_for_human": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
