{
  "type": "object",
  "required": ["sheet", "cells"],
  "additionalProperties": true,
  "properties": {
    "sheet": { "type": "string" },
    "unreadable": { "type": "boolean" },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cell", "depicts", "detail", "condition", "bulk", "palette", "legible"],
        "additionalProperties": true,
        "properties": {
          "cell": { "type": "integer", "minimum": 1 },
          "depicts": { "type": "string", "minLength": 2, "maxLength": 80 },
          "detail": { "type": "string", "minLength": 10, "maxLength": 400 },
          "condition": {
            "type": "string",
            "enum": ["intact", "bent", "torn", "cracked", "scorched", "fragmentary"]
          },
          "bulk": { "type": "string", "enum": ["compact", "flat", "long", "bulky"] },
          "palette": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 2, "maxLength": 24 }
          },
          "legible": { "type": "string", "enum": ["clear", "partial", "ambiguous"] }
        }
      }
    }
  }
}
