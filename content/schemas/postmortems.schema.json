{
  "type": "object",
  "required": ["agent", "screens"],
  "additionalProperties": false,
  "properties": {
    "agent": { "const": "postmortem-writer" },
    "screens": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "title", "cause", "rule_broken", "armstrong", "grounded_in"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string", "pattern": "^[^\\n]{3,32}$" },
          "cause": { "type": "string", "pattern": "^[^\\n]{20,160}$" },
          "rule_broken": { "type": "string", "pattern": "^[^\\n]{20,200}$" },
          "armstrong": { "type": "string", "pattern": "^[^\\n]{12,180}$" },
          "grounded_in": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[a-z]?$" }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
