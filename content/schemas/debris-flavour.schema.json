{
  "type": "object",
  "required": ["agent", "pieces"],
  "additionalProperties": false,
  "properties": {
    "agent": { "const": "debris-flavourist" },
    "pieces": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "flavour", "reads_as", "grounded_in"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string", "pattern": "^[^\\n]{3,42}$" },
          "flavour": { "type": "string", "pattern": "^[^\\n]{40,260}$" },
          "reads_as": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["light", "heavy", "low", "high", "fragile", "solid", "cheap", "valuable"]
            }
          },
          "grounded_in": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?[a-z]?$" }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
