_in\": [\"2.7a\", \"2.3\"]\n    },\n    {\n      \"id\": \"refused\",\n      \"title\": \"REFUSED\",\n      \"cause\": \"The module was delivered in scrap state. Delivery was refused, and the drones returned it to orbit for a re-fly.\",\n      \"rule_broken\": \"A scrap-state module delivery resolves to refused — a loss, never a win; scrap never wins the run.\",\n      \"armstrong\": \"Not like that, kid. She goes back up and you fly it again.\",\n      \"grounded_in\": [\"2.7a\", \"2.6c\", \"1b\"]\n    },\n    {\n      \"id\": \"zero_hp\",\n      \"title\": \"SHIP DESTROYED\",\n      \"cause\": \"The ship is gone — a hard landing, or a reentry hot enough to pin the bar and burn through plate, then cargo, then hull.\",\n      \"rule_broken\": \"Heat spends shield plate first, cargo second, hull last; landings are graded on vertical speed, soft under about 5 m/s.\",\n      \"armstrong\": \"She's scrap now, kid. Pad's clear — cash and upgrades keep.\",\n      \"grounded_in\": [\"2.7a\", \"2.2g\", \"2.3\"]\n    },\n    {\n      \"id\": \"burned_up\",\n      \"title\": \"BURNED UP\",\n      \"cause\": \"The astronaut was outside, in atmosphere, above the heat-speed threshold.\",\n      \"rule_broken\": \"The suit carries no heat protection — fuel is no defense, and F is inert once heat builds.\",\n      \"armstrong\": \"Suit's not a shield, kid. Never was.\",\n      \"grounded_in\": [\"2.4c\", \"2.7a\", \"1b\"]\n    },\n    {\n      \"id\": \"stranded\",\n      \"title\": \"STRANDED\",\n      \"cause\": \"The run could no longer reach a landing and no recovery input remained. The check fired and called it here.\",\n      \"rule_broken\": \"One unwinnability check fires when no landing remains and no input recovers it; warp is disabled the instant it arms.\",\n      \"armstrong\": \"Nothing left to fly out of that one, kid. Pad's waiting.\",\n      \"grounded_in\": [\"2.7b\"]\n    },\n    {\n      \"id\": \"stranded_a\",\n      \"title\": \"STRANDED\",\n      \"cause\": \"The ship cannot deorbit — out of fuel, or staged so the tank is gone — on an arc whose periapsis never enters the atmosphere.\",\n      \"rule_broken\": \"Staging is one-way and kills all thrust, and an arc whose periapsis never enters the atmosphere never comes down.\",\n      \"armstrong\": \"No tank, no burn, no down. That's the arithmetic, kid.\",\n      \"grounded_in\": [\"2.7b\", \"3b\"]\n    },\n    {\n      \"id\": \"stranded_b\",\n      \"title\": \"STRANDED\",\n      \"cause\": \"The jetpack ran dry with the astronaut beyond tether reach of the ship.\",\n      \"rule_broken\": \"The magnet grips the hull, so a dry jetpack inside tether range is only an inconvenience — outside it, nothing to winch.\",\n      \"armstrong\": \"RETURN lamp goes red, you let the piece go. Every time, kid.\",\n      \"grounded_in\": [\"2.4b\", \"2.4a\", \"2.7b\"]\n    },\n    {\n      \"id\": \"stranded_c\",\n      \"title\": \"STRANDED\",\n      \"cause\": \"The astronaut touched terrain while not aboard the ship. The descent stayed under the heat-speed threshold, so it was survivable.\",\n      \"rule_broken\": \"Landed requires the astronaut aboard — touching terrain while not aboard the ship is stranded, not a landing.\",\n      \"armstrong\": \"Standing in the dirt without her is still standing in the dirt, kid.\",\n      \"grounded_in\": [\"2.7a\", \"2.4c\", \"3b\"]\n    },\n    {\n      \"id\": \"stranded_d\",\n      \"title\": \"STRANDED\",\n      \"cause\": \"Staged, chute shredded, and the lowest touchdown speed still reachable was past the destruction cap.\",\n      \"rule_broken\": \"A parachute deployed during plasma shreds; a conservative closed-form check resolves the doomed descent as 0 HP at once.\",\n      \"armstrong\": \"Canopy's gone, kid. Wasn't coming down soft after that.\",\n      \"grounded_in\": [\"2.7b\", \"2.2g\", \"2.4b\"]\n    }\n  ],\n  \"notes\": [\n    \"landed is not a failure; its screen reports what ended the run rather than a mistake.\",\n